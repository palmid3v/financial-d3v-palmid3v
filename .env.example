APP_ENV=development
HTTP_ADDR=:8080

# Firebase / Firestore
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=financial-d3v-dev
# Optional local service-account path. Prefer GOOGLE_APPLICATION_CREDENTIALS or ADC when possible.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# X-Owner-ID is temporary until Firebase Auth is implemented in FASE 12.
\n# Require Firebase ID tokens when Firebase is enabled\nAUTH_REQUIRED=true\n