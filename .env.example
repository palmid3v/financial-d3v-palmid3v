APP_ENV=development
HTTP_ADDR=:8080

# Firebase / Firestore
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=financial-d3v-dev

# Optional local service-account path.
# Prefer Application Default Credentials / platform secret injection in hosted environments.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# Development may use X-Owner-ID because Firebase Auth is disabled.
# Production must keep authentication required.
AUTH_REQUIRED=false

# Comma-separated browser origins allowed by the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
