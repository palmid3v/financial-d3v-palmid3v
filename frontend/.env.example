# Local development
VITE_API_BASE_URL=http://localhost:8080

# Production: keep this empty so /api/v1/... stays on the Firebase Hosting origin.
# VITE_API_BASE_URL=

# Production Firebase Auth
# VITE_FIREBASE_AUTH_ENABLED=true
# VITE_FIREBASE_API_KEY=<public Firebase Web API key>
# VITE_FIREBASE_PROJECT_ID=financial-d3v-palmid3v

# Set true only while validating the Financial Vault gate. The data migration is a later phase.
VITE_FINANCIAL_VAULT_ENABLED=true
